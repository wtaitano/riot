# This file was made in part with generative AI.

# Skeleton deck: a small 2D mesh with one tensor-train field per block. The ckm
# driver fills the field and checks it; no evolution.

<parthenon/job>
problem_id = ckm_skeleton

<parthenon/mesh>
refinement = none

nx1 = 32
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 32
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -0.5
x3max = 0.5

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 1

<parthenon/time>
tlim = 0.0
nlim = 0

<ckm>
n1 = 8          # physical dimension of the first non-spatial TT core
n2 = 8          # physical dimension of the second non-spatial TT core
fill_value = 1.0
