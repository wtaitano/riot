# Personal, never committed (shared config is .claude/settings.json).
.claude/settings.local.json
CLAUDE.local.md

# Personal scratch area, never committed. Commands a human must run, notes, drafts.
# Anything the team should see belongs in plan_histories/ or doc/ instead.
scratch/

# Project map drawn by the project-map agent (.claude/agents/project-map.md). Personal,
# redrawn on demand; open .project-map/index.html to see it.
/.project-map/

# Empty placeholders that Claude Code's sandbox creates when a session starts here (the
# sandbox blocks writes to these names, and it needs a file to mount over each one).
# They are 0 bytes or /dev/null and are safe to delete once no session is running.
# ckm uses none of these files: it has no submodules, no JS tooling and no .github/.
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.gitmodules
/.github
/.idea
/.vscode
/.mcp.json
/.ripgreprc
/scripts
/node_modules/
/.env
/.env.*
/.npmrc
/.yarnrc
/.yarnrc.yml
/bunfig.toml
/package.json
/package-lock.json
/pnpm-lock.yaml
/yarn.lock
